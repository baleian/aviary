#!/bin/sh
# Entrypoint of a session sandbox, started as the agent's user in /. Runs the
# runner in the session workspace.
set -eu
# The session volume has no workspace yet when the session is new.
mkdir -p /home/workspace
cd /home/workspace
export HOME=/home
# npm and pip install into the home, which outlives the pod. pip does so by
# itself, since it cannot write to the system Python, but Debian allows it to
# install outside a virtual environment only with PIP_BREAK_SYSTEM_PACKAGES.
export NPM_CONFIG_PREFIX=/home/.local PATH="/home/.local/bin:$PATH" PIP_BREAK_SYSTEM_PACKAGES=1
exec aviary-runner
