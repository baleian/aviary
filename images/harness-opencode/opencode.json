{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "doom_loop": "allow",
    "external_directory": "allow",
    "read": "allow"
  },
  "provider": {
    "aviary": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:AVIARY_LLM_BASE_URL}",
        "apiKey": "{env:AVIARY_LLM_API_KEY}"
      },
      "models": {
        "{env:AVIARY_LLM_MODEL}": {
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "model": "aviary/{env:AVIARY_LLM_MODEL}"
}
