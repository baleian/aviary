#!/bin/sh
# Claude Code reads the model endpoint from variables of its own, and adds /v1
# to the URL itself.
set -eu
export ANTHROPIC_BASE_URL="${AVIARY_LLM_BASE_URL%/v1}" \
  ANTHROPIC_AUTH_TOKEN="$AVIARY_LLM_API_KEY" \
  ANTHROPIC_MODEL="$AVIARY_LLM_MODEL"
# Claude Code names other models by alias for some work, such as a title for
# the session and some subagents. Each alias is the agent's model.
export ANTHROPIC_DEFAULT_FABLE_MODEL="$AVIARY_LLM_MODEL" \
  ANTHROPIC_DEFAULT_OPUS_MODEL="$AVIARY_LLM_MODEL" \
  ANTHROPIC_DEFAULT_SONNET_MODEL="$AVIARY_LLM_MODEL" \
  ANTHROPIC_DEFAULT_HAIKU_MODEL="$AVIARY_LLM_MODEL"
exec claude-agent-acp
