#!/bin/sh
# Codex takes the model and the provider address from its configuration, not
# from the environment. The ACP adapter accepts configuration as JSON.
set -eu
CODEX_CONFIG=$(jq --null-input --compact-output \
  --arg model "$AVIARY_LLM_MODEL" --arg base_url "$AVIARY_LLM_BASE_URL" \
  '{model: $model, model_provider: "aviary", model_providers: {aviary: {base_url: $base_url}}}')
export CODEX_CONFIG
# An agent that is to ask runs Codex in the mode in which it changes nothing
# and fetches nothing unasked. Codex keeps the commands of that mode in its
# sandbox, which does not start in a pod, so a command only runs once the
# model has asked for it to run outside the sandbox and a person has agreed.
if [ "${AVIARY_APPROVAL:-}" = ask ]; then
  export INITIAL_AGENT_MODE=read-only
fi
exec codex-acp
