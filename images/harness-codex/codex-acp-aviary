#!/bin/sh
# Codex reads the model and the provider's URL from its configuration, not
# from the environment. The ACP adapter takes configuration as JSON.
set -eu
CODEX_CONFIG=$(jq --null-input --compact-output \
  --arg model "$AVIARY_LLM_MODEL" --arg base_url "$AVIARY_LLM_BASE_URL" \
  '{model: $model, model_provider: "aviary", model_providers: {aviary: {base_url: $base_url}}}')
export CODEX_CONFIG
# Read-only mode makes Codex ask: it runs commands in its sandbox, which
# cannot start in a pod, so a command runs only after the model asks to run it
# outside the sandbox and a person allows it.
if [ "${AVIARY_APPROVAL:-}" = ask ]; then
  export INITIAL_AGENT_MODE=read-only
fi
exec codex-acp
