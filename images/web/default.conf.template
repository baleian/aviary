server {
    listen 8080;
    server_tokens off;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # The web UI loads its scripts, styles and fonts only from its own
    # address, and is not shown in a frame. It may call the API and the
    # issuer wherever they are, and draw the pictures among the files that
    # it has read from the API: the browser names those with blob.
    add_header Content-Security-Policy "default-src 'self'; connect-src *; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    # The address of a sign-in that comes back carries its code.
    add_header Referrer-Policy no-referrer always;

    location = /healthz {
        access_log off;
        return 204;
    }

    # The page in which the web UI shows a web page that an agent wrote. It
    # has no origin, so the scripts of what it shows have nothing of the web
    # UI's, and it loads only into a frame of the web UI.
    location = /sandbox.html {
        add_header Content-Security-Policy "sandbox allow-scripts; frame-ancestors 'self'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        expires -1;
    }

    # What the installation sets for the web UI, from the environment.
    location = /config.json {
        alias /etc/nginx/conf.d/config.json;
        expires -1;
    }

    location /v1/ {
        ${AVIARY_API_LOCATION}
        # Event streams are passed on as they come.
        proxy_buffering off;
        # So are the files that messages carry, of whatever size: the API
        # says how large a file may be.
        client_max_body_size 0;
        proxy_request_buffering off;
    }

    # Files whose names change with their contents.
    location ~ ^/(assets|fonts)/ {
        expires 1y;
    }

    # Every other path is a screen of the web UI.
    location / {
        try_files $uri /index.html;
        expires -1;
    }
}
